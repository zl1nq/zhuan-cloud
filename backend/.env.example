# ===== 筑安云环境配置模板（复制为 .env 后填写）=====
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=csu

# AI模式：true=内置模拟引擎(零API消耗) false=调用通义千问
MOCK_MODE=true
# 阿里云百炼(DashScope) API Key，https://open.bigmodel.cn 不适用，请用 bailian.console.aliyun.com 申请
DASHSCOPE_API_KEY=
QWEN_TEXT_MODEL=qwen-flash
QWEN_VL_MODEL=qwen-vl-plus
QWEN_EMBED_MODEL=text-embedding-v4
QWEN_ASR_MODEL=qwen3-asr-flash

# ===== 邮箱验证码注册（不配则注册功能不可用，只能用演示账号登录）=====
# QQ邮箱填 smtp.qq.com ；163邮箱填 smtp.163.com
SMTP_HOST=
# 465=SSL（推荐）；587=STARTTLS
SMTP_PORT=465
# 完整邮箱地址（不是QQ号）
SMTP_USER=
# 授权码（16位字母，非邮箱登录密码），获取步骤见 README
SMTP_PASS=
# 发件人地址，留空则自动用 SMTP_USER
SMTP_FROM=
